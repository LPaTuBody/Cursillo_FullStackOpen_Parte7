{
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "tabWidth": 2,
        "singleQuote": false,
        "semi": false,
        "trailingComma": "none",
        "bracketSpacing": true
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "options": {
        "tabWidth": 2,
        "singleQuote": true,
        "semi": false,
        "arrowParens": "always"
      }
    },
    {
      "files": "*.css",
      "options": {
        "tabWidth": 4,
        "singleQuote": false,
        "semi": true,
        "bracketSpacing": true
      }
    }
  ]
}
